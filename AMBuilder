import os

project = builder.LibraryProject(MMSPlugin.metadata["name"])

for sdk_target in MMSPlugin.sdk_targets:
  sdk = sdk_target.sdk
  cxx = sdk_target.cxx

  binary = MMSPlugin.HL2Library(builder, cxx, project, sdk)

  binary.compiler.cxxincludes += [
    os.path.join(builder.sourcePath, 'src', 'utils'),
    os.path.join(builder.sourcePath, 'public'),
  ]

  if builder.options.opt == '1':
    if binary.compiler.behavior == 'gcc':
      binary.compiler.cxxflags += ['-g0']

  if binary.compiler.target.platform == 'linux':
    binary.sources += ['src/utils/plat_unix.cpp']
  elif binary.compiler.target.platform == 'windows':
    binary.sources += ['src/utils/plat_win.cpp']

  binary.sources += [
    'src/multiaddonmanager.cpp'
  ]

  protoc_builder = builder.tools.Protoc(protoc = sdk_target.protoc, sources = [
    os.path.join(sdk['path'], 'common', 'network_connection.proto'),
    os.path.join(sdk['path'], 'common', 'networkbasetypes.proto'),
    os.path.join(sdk['path'], 'common', 'netmessages.proto'),
    os.path.join(sdk['path'], 'common', 'source2_steam_stats.proto'),
    os.path.join(sdk['path'], 'common', 'valveextensions.proto')
  ])

  binary.custom = [protoc_builder]

MMSPlugin.tasks += builder.Add(project)
